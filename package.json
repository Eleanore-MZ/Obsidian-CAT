{
  "name": "obsidian-cat",
  "version": "0.0.4",
  "description": "Highlights corresponding lines and blocks between a pair of bilingual notes in Obsidian.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "node scripts/run-tests.mjs"
  },
  "keywords": [
    "obsidian",
    "translation",
    "bilingual"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.14.4",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0"
  }
}
